/*
  Cache-Control: public, max-age=3600
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Link: <https://toolaspect.com>; rel="canonical"

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=86400

/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400

# LGPL-3.0 heic-to decoder, shipped unmodified — needs CORS for cross-origin
# dynamic import() by the embeddable widget. Lib file stays byte-identical.
/heic-to-jpg-converter/vendor/*
  Access-Control-Allow-Origin: *

# Apache-2.0 pdfstudio (qpdf-wasm), vendored unmodified — the ESM entry + wasm
# fetch need CORS when embed widgets on other sites dynamic-import() them.
/shared/vendor/pdfstudio/*
  Access-Control-Allow-Origin: *
